---
import Base from '../layouts/Base.astro';
import { PERSON, VARIANTS } from '../data/resume';
---

<Base title={`${PERSON.name} 이력서`} description="클라우드, DevOps와 네트워크 엔지니어 이력서">
  <main class="choose">
    <h1>{PERSON.name}</h1>
    <p>지원하는 직무에 맞는 이력서를 고르세요.</p>
    <ul>
      {
        VARIANTS.map((v) => (
          <li>
            <a href={`/${v.slug}/`}>
              <span class="name">{v.role}</span>
              <span class="go" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="more">프로젝트 전체는 <a href={PERSON.portfolio}>woosupar.dev</a>에 있습니다.</p>
  </main>
</Base>

<style>
  .choose {
    max-width: 36rem;
    margin: 0 auto;
    min-height: 100dvh;
    padding: 4rem 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  h1 {
    margin: 0;
    font-size: clamp(3rem, 10vw, 4.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  p {
    margin: 1rem 0 2rem;
    color: var(--muted);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  li a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 0.25rem;
    border-bottom: 1px solid var(--line);
    font-size: var(--text-heading);
    font-weight: 600;
    text-decoration: none;
  }

  .go {
    transition: transform 180ms var(--ease);
  }

  li a:hover .go {
    transform: translateX(4px);
  }

  .more {
    margin-top: 2rem;
    font-size: var(--text-sm);
  }
</style>
