---
import { EDUCATION, PERSON, VARIANTS, type Variant } from '../data/resume';

interface Props {
  variant: Variant;
}

const { variant } = Astro.props;
const host = (url: string) => url.replace(/^https?:\/\//, '');
---

<main class="sheet">
  <header class="masthead">
    <div class="identity">
      <h1>{PERSON.name}</h1>
      <p class="role">{variant.role}</p>
    </div>
    <nav class="switch" aria-label="이력서 버전">
      {
        VARIANTS.map((v) => (
          <a href={`/${v.slug}/`} aria-current={v.slug === variant.slug ? 'page' : undefined}>
            {v.label}
          </a>
        ))
      }
    </nav>
    <p class="contact">
      <a href={`mailto:${PERSON.email}`}>{PERSON.email}</a>
      <a href={PERSON.github}>{host(PERSON.github)}</a>
      <a href={PERSON.portfolio}>{host(PERSON.portfolio)}</a>
    </p>
  </header>

  <section class="row">
    <h2>소개</h2>
    <p class="summary">{variant.summary}</p>
  </section>

  <section class="row">
    <h2>기술</h2>
    <dl class="skills">
      {
        variant.skills.map((s) => (
          <div>
            <dt>{s.group}</dt>
            <dd>{s.items}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="row">
    <h2>프로젝트</h2>
    <div class="projects">
      {
        variant.projects.map((p) => (
          <article class="project">
            <div class="project-head">
              <h3>
                <a href={p.link}>{p.name}</a>
              </h3>
              <p class="meta">
                {p.period}, {p.team}
              </p>
            </div>
            <p class="stack">{p.stack}</p>
            <ul>
              {p.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <section class="row">
    <h2>교육</h2>
    <ul class="timeline">
      {
        EDUCATION.map((e) => (
          <li>
            <span class="when">{e.when}</span>
            <span>
              <strong>{e.name}</strong>
              {e.note && <span class="note">{e.note}</span>}
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="row">
    <h2>자격</h2>
    <ul class="timeline">
      {
        variant.certs.map((c) => (
          <li>
            <span class="when">{c.when}</span>
            <strong>{c.name}</strong>
          </li>
        ))
      }
    </ul>
  </section>

  <footer class="foot">
    <p>프로젝트별 구성도와 측정 기록은 <a href={PERSON.portfolio}>{host(PERSON.portfolio)}</a>에 있습니다.</p>
    <button class="print" type="button" onclick="window.print()">PDF로 저장</button>
  </footer>
</main>

<style>
  .sheet {
    max-width: 52rem;
    margin: 2.5rem auto 4rem;
    padding: 3.5rem 4rem 2.5rem;
    background: var(--sheet);
    border-top: 6px solid var(--accent);
    box-shadow: 0 1px 2px rgb(16 32 42 / 6%), 0 12px 32px rgb(16 32 42 / 6%);
  }

  .masthead {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    gap: 0.75rem 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--line);
  }

  h1 {
    margin: 0;
    font-size: clamp(2.75rem, 7vw, 4.25rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .role {
    margin: 0.75rem 0 0;
    font-size: var(--text-heading);
    font-weight: 600;
    color: var(--accent);
  }

  .contact {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin: 0;
    font-size: var(--text-body);
    color: var(--muted);
  }

  .switch {
    display: inline-flex;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 3px;
    background: var(--bg);
  }

  .switch a {
    padding: 0.35rem 0.9rem;
    border-radius: 4px;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
    transition: background-color 160ms var(--ease), color 160ms var(--ease);
  }

  .switch a[aria-current='page'] {
    background: var(--sheet);
    color: var(--accent);
    box-shadow: 0 1px 2px rgb(16 32 42 / 12%);
  }

  .row {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 1.5rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--line);
  }

  .row:last-of-type {
    border-bottom: 0;
  }

  h2 {
    margin: 0;
    font-size: var(--text-heading);
    font-weight: 700;
    line-height: 1.5;
  }

  .summary {
    margin: 0;
    max-width: 65ch;
  }

  .skills {
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }

  .skills div {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1rem;
  }

  .skills dt {
    font-weight: 600;
  }

  .skills dd {
    margin: 0;
    color: var(--ink);
  }

  .projects {
    display: grid;
    gap: 1.75rem;
  }

  .project-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0 1rem;
  }

  h3 {
    margin: 0;
    font-size: var(--text-heading);
    font-weight: 700;
  }

  h3 a {
    text-decoration: none;
  }

  .meta,
  .stack,
  .note,
  .when {
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .meta {
    margin: 0;
  }

  .stack {
    margin: 0.15rem 0 0.5rem;
  }

  .project ul {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.3rem;
  }

  .project li::marker {
    color: var(--accent);
  }

  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }

  .timeline li {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 1rem;
    align-items: baseline;
  }

  .timeline strong {
    font-weight: 600;
  }

  .note {
    display: block;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .foot p {
    margin: 0;
  }

  .print {
    font: inherit;
    font-weight: 600;
    color: var(--sheet);
    background: var(--accent);
    border: 0;
    border-radius: 6px;
    padding: 0.55rem 1.1rem;
    cursor: pointer;
    transition: filter 160ms var(--ease);
  }

  .print:hover {
    filter: brightness(1.12);
  }

  @media (max-width: 44rem) {
    .sheet {
      margin: 0;
      padding: 2rem 1.25rem 2rem;
      box-shadow: none;
    }

    .masthead {
      grid-template-columns: 1fr;
    }

    .switch {
      grid-row: 1;
      justify-self: start;
    }

    .row {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .skills div,
    .timeline li {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }

  @media print {
    @page {
      size: A4;
      margin: 11mm 13mm;
    }

    .sheet {
      max-width: none;
      margin: 0;
      padding: 0;
      border-top: 0;
      box-shadow: none;
    }

    .switch,
    .print {
      display: none;
    }

    h1 {
      font-size: 24pt;
    }

    .role {
      margin-top: 0.3rem;
    }

    .masthead {
      padding-bottom: 0.5rem;
      gap: 0.3rem 2rem;
    }

    .row {
      padding: 0.45rem 0;
      grid-template-columns: 4.5rem 1fr;
      gap: 0.8rem;
    }

    .skills {
      gap: 0.1rem;
    }

    .skills div {
      grid-template-columns: 6.5rem 1fr;
    }

    .projects {
      gap: 0.5rem;
    }

    .stack {
      margin: 0 0 0.15rem;
    }

    .project ul {
      gap: 0.05rem;
    }

    .timeline {
      gap: 0.15rem;
    }

    .timeline li {
      grid-template-columns: 6.5rem 1fr;
    }

    .note {
      display: inline;
      margin-left: 0.5rem;
    }

    .foot {
      margin-top: 0;
      padding-top: 0.4rem;
    }

    .project,
    .timeline li {
      break-inside: avoid;
    }

    a {
      text-decoration: none;
    }
  }
</style>
